# ── Security headers (all responses) ─────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https:; frame-src https://bandcamp.com https://video.bunny.net https://audio.bunny.net; connect-src 'self' https://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'
  Cache-Control: no-cache, must-revalidate

# ── Vite hashed assets — content-addressed, cache 1 year ─────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Service worker — always revalidate ───────────────────────────────────────
/sw.js
  Cache-Control: no-cache, must-revalidate

# ── RSS feed — 1 hour ─────────────────────────────────────────────────────────
/feed.xml
  Cache-Control: public, max-age=3600
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https:; frame-src https://bandcamp.com https://video.bunny.net https://audio.bunny.net; connect-src 'self' https://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'

/feed.xsl
  Cache-Control: public, max-age=3600

# ── Uploaded images — 30 days ────────────────────────────────────────────────
/images/*
  Cache-Control: public, max-age=2592000

# ── Favicon — 1 day ──────────────────────────────────────────────────────────
/favicon.svg
  Cache-Control: public, max-age=86400
